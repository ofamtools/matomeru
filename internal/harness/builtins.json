[
  {
    "name": "claude",
    "command": ["claude"],
    "ids": ["claude*"],
    "modelFlag": "--model",
    "models": ["opus", "sonnet", "haiku"],
    "prompt": "send-text",
    "ready": {
      "state": "idle,done",
      "timeoutMs": 15000
    },
    "attach": "mention",
    "settings": {
      "effort": {
        "values": ["low", "medium", "high", "xhigh", "max", "auto"],
        "command": "/effort {value}"
      },
      "fast": {
        "values": ["on", "off"],
        "command": "/fast {value}"
      },
      "model": {
        "values": ["opus", "fable", "sonnet", "haiku", "default"],
        "command": "/model {value}",
        "note": "Claude Code also saves it as the default for new sessions"
      },
      "permission-mode": {
        "key": "BTab",
        "cycle": ["default", "acceptEdits", "plan", "bypassPermissions", "auto"],
        "screen": {
          "acceptEdits": "accept edits on",
          "auto": "auto mode on",
          "bypassPermissions": "bypass permissions on",
          "plan": "plan mode on"
        },
        "flags": ["--permission-mode", "{value}"]
      }
    },
    "contextWindows": {
      "claude-*": 200000,
      "claude-*\\[1m\\]": 1000000,
      "claude-fable-5*": 1000000,
      "claude-opus-5*": 1000000
    },
    "session": {
      "agents": ["claude-code", "claude"],
      "files": "${CLAUDE_CONFIG_DIR:-~/.claude}/sessions/*.json",
      "pid": "pid",
      "start": "procStart",
      "env": ["TUIOS_WINDOW_ID", "TUIOS_PANE_ID"],
      "session": "sessionId",
      "cwd": "cwd",
      "transcript": "${CLAUDE_CONFIG_DIR:-~/.claude}/projects/{cwd_slug}/{session}.jsonl"
    },
    "log": "claude",
    "promptBox": {
      "deliver": "queue",
      "submit": "enter"
    },
    "hookArgs": ["--settings", "{\"hooks\":{\"Notification\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"SessionStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"UserPromptSubmit\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"PermissionRequest\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":310}]}],\"PostToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"PostToolUseFailure\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"PermissionDenied\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"ElicitationResult\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"StopFailure\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"SessionEnd\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"SubagentStart\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}],\"SubagentStop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"{mtm_json} agent hook claude-code --integration 3\",\"timeout\":5}]}]}}"],
    "agentEnv": ["CLAUDECODE"],
    "compose": {
      "oai": "claude",
      "inputs": ["{claudeDir}/settings.json", "{claudeDir}/plugins/installed_plugins.json"],
      "skills": [
        {
          "path": "{claudeDir}/skills",
          "scope": "user"
        },
        {
          "up": [
            {
              "path": ".claude/skills",
              "scope": "project"
            }
          ]
        },
        {
          "path": "skills",
          "scope": "plugin",
          "plugins": "{claudeDir}"
        }
      ],
      "commandDirs": [
        {
          "up": [
            {
              "path": ".claude/commands",
              "scope": "project"
            }
          ]
        },
        {
          "path": "{claudeDir}/commands",
          "scope": "user"
        },
        {
          "path": "commands",
          "scope": "plugin",
          "plugins": "{claudeDir}"
        }
      ],
      "commands": ["add-dir", "agents", "bug", "clear", "compact", "config", "context", "cost", "doctor", "exit", "export", "help", "hooks", "init", "login", "logout", "mcp", "memory", "model", "permissions", "plugin", "pr-comments", "release-notes", "resume", "review", "rewind", "security-review", "status", "statusline", "todos", "usage", "vim"],
      "skill": "/{name}",
      "pluginSkill": "/{plugin}:{name}"
    },
    "mcp": "claude"
  },
  {
    "name": "omp",
    "command": ["omp"],
    "ids": ["omp"],
    "modelFlag": "--model",
    "prompt": "send-text",
    "ready": {
      "state": "idle,done",
      "timeoutMs": 15000
    },
    "attach": "mention",
    "settings": {
      "effort": {
        "values": ["off", "minimal", "low", "medium", "high", "xhigh", "max", "auto"],
        "command": "/effort {value}"
      },
      "fast": {
        "values": ["on", "off"],
        "command": "/fast {value}"
      },
      "model": {
        "command": "/switch {value}"
      }
    },
    "session": {
      "agents": ["omp"],
      "files": "${PI_CODING_AGENT_DIR:-~/.omp/agent}/terminal-sessions/{tty}",
      "format": "lines",
      "process": "omp",
      "cwd": "1",
      "path": "2",
      "sessionPattern": "_([0-9A-Za-z-]+)\\.jsonl$"
    },
    "log": "omp",
    "promptBox": {
      "deliver": "queue",
      "submit": "enter"
    },
    "compose": {
      "oai": "omp",
      "config": "{ompDir}/config.yml",
      "inputs": ["{ompDir}/config.yml"],
      "skills": [
        {
          "path": "{ompDir}/skills",
          "scope": "user",
          "if": ["skills.enabled!=false"]
        },
        {
          "path": "{ompDir}/managed-skills",
          "scope": "managed",
          "if": ["skills.enabled!=false"]
        },
        {
          "path": "~/.agents/skills",
          "scope": "shared",
          "if": ["skills.enabled!=false"]
        },
        {
          "up": [
            {
              "path": ".omp/skills",
              "scope": "project"
            },
            {
              "path": ".agents/skills",
              "scope": "project"
            },
            {
              "path": ".claude/skills",
              "scope": "project"
            }
          ],
          "if": ["skills.enabled!=false"]
        },
        {
          "path": "{claudeDir}/skills",
          "scope": "user",
          "if": ["skills.enabled!=false", "skills.enableClaudeUser"]
        },
        {
          "scope": "configured",
          "list": "skills.customDirectories",
          "if": ["skills.enabled!=false"]
        }
      ],
      "commandDirs": [
        {
          "up": [
            {
              "path": ".omp/commands",
              "scope": "project"
            },
            {
              "path": ".claude/commands",
              "scope": "project",
              "if": ["commands.enableClaudeProject!=false"]
            }
          ]
        },
        {
          "path": "{ompDir}/commands",
          "scope": "user"
        },
        {
          "path": "{claudeDir}/commands",
          "scope": "user",
          "if": ["commands.enableClaudeUser"]
        }
      ],
      "commands": ["add-dir", "advisor", "agents", "branch", "btw", "changelog", "clear", "collab", "compact", "context", "copy", "debug", "delete", "dirs", "dump", "effort", "exit", "export", "extensions", "fast", "fork", "fresh", "git", "goal", "handoff", "hotkeys", "jobs", "login", "logout", "loop", "marketplace", "mcp", "memory", "model", "move", "new", "open", "plan", "plugins", "queue", "quit", "reload-plugins", "rename", "restart", "resume", "retry", "session", "settings", "setup", "share", "skills", "slow", "stats", "switch", "todo", "tools", "trace", "tree", "usage"],
      "skill": "/skill:{name}"
    },
    "mcp": "omp"
  },
  {
    "name": "codex",
    "command": ["codex"],
    "ids": ["codex*"],
    "modelFlag": "--model",
    "prompt": "send-text",
    "ready": {
      "state": "idle,done",
      "timeoutMs": 15000
    },
    "attach": "paste",
    "promptBox": {
      "deliver": "queue",
      "submit": "enter"
    },
    "log": "codex",
    "compose": {
      "oai": "codex",
      "skills": [
        {
          "path": "~/.codex/skills",
          "scope": "user"
        },
        {
          "path": "~/.agents/skills",
          "scope": "shared"
        },
        {
          "up": [
            {
              "path": ".codex/skills",
              "scope": "project"
            },
            {
              "path": ".agents/skills",
              "scope": "project"
            }
          ]
        }
      ],
      "commands": ["approvals", "compact", "diff", "init", "logout", "mcp", "mention", "model", "new", "quit", "review", "status"],
      "skill": "${name}"
    },
    "mcp": "codex"
  }
]
