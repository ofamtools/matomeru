key	outside	leader (no-motions)
"	mode.enter	send to program (focus-bound)
'	page.pick [no-modal]	page.pick (explicit)
(	focus.previous	send to program (motion)
)	focus.next	send to program (motion)
*	pane.set	terminal.star (explicit)
,	setting.open [no-modal]	setting.open (explicit)
.	history.repeat	history.repeat (outside)
/	list.filter-open [list-filterable]	send to program (focus-bound)
:	palette.open	palette.open (explicit)
?	bindings.help	bindings.help (explicit)
@	mode.enter	send to program (focus-bound)
G	list.goto	send to program (motion)
I	page.open	page.open (explicit)
J	detail.scroll [detail-scrolls]	send to program (motion)
K	detail.scroll [detail-scrolls]	send to program (motion)
L	agent.choose	agent.choose (explicit)
N	quick-note.open	quick-note.open (explicit)
P	project.pick [no-modal]	project.pick (explicit)
Q	mode.enter	send to program (focus-bound)
R	pane.refresh-turns [pane-tab-turns]	terminal.layout (explicit)
S	scope.all	scope.all (explicit)
T	todos.open	todos.open (explicit)
V	list.visual	send to program (focus-bound)
W	panes.waiting	terminal.waiting (explicit)
Y	list.yank	list.yank (outside)
[	panes.tab	terminal.copy (explicit)
\	pane.pick [no-modal]	pane.pick (explicit)
]	panes.tab	send to program (focus-bound)
`	panes.starred	terminal.starred (explicit)
a	—	terminal.send (explicit)
alt+?	state.toggle	state.toggle (outside)
c	—	context-item.pick (explicit)
ctrl+a	—	terminal.send (explicit)
ctrl+b	list.scroll	send to program (motion)
ctrl+c	app.quit [no-modal]	app.quit [no-modal] (outside)
ctrl+d	list.scroll	send to program (motion)
ctrl+f	list.scroll	send to program (motion)
ctrl+j	page.next	page.next (explicit)
ctrl+k	page.previous	page.previous (explicit)
ctrl+space	palette.open	palette.open (explicit)
ctrl+u	list.scroll	send to program (motion)
d	—	terminal.sideDetach (explicit)
down	list.move	send to program (motion)
e	daemon.ensure [daemon-down]	daemon.ensure [daemon-down] (outside)
enter	pane.attach	send to program (focus-bound)
f	pane.hints	terminal.hints (explicit)
h	focus.previous [table-spills-left]	send to program (motion)
i	pane.prompt	send to program (focus-bound)
j	list.move	terminal.cycle (explicit)
k	list.move	terminal.cycle (explicit)
l	pane.copy [pane-tab-screen]	pane.copy [pane-tab-screen] (outside)
left	focus.previous [table-spills-left]	send to program (motion)
m	pane.choose-move	pane.choose-move (outside)
n	pane.new	task.new (explicit)
o	—	terminal.other (explicit)
p	—	pane.pick (explicit)
pgdown	surface.scroll	send to program (motion)
pgup	surface.scroll	send to program (motion)
r	pane.edit	pane.edit (outside)
right	focus.next [table-spills-right]	send to program (motion)
s	—	terminal.starred (explicit)
shift+tab	focus.previous	send to program (motion)
space	list.mark	list.mark (outside)
t	pane.pick-task	terminal.side (explicit)
tab	focus.next	send to program (motion)
up	list.move	send to program (motion)
v	—	terminal.side (explicit)
w	saved.save	panes.sides (explicit)
y	list.yank [table-cells]	list.yank [table-cells] (outside)
z	—	terminal.zoom (explicit)
{	focus.previous	send to program (motion)
}	focus.next	send to program (motion)
