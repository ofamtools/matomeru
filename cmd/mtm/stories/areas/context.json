{
  "name": "mtm: curate context from an empty page, revise it and annotate the focused item",
  "area": "context",
  "fixture": "area-context",
  "width": 140,
  "height": 36,
  "config": {
    "bindings.json": [
      {"noun": "app", "mode": "normal", "keys": "ctrl+x", "request": {"noun": "ochazuke.page", "verb": "open", "args": {"id": "context"}}}
    ]
  },
  "script": [
    "ctrl+x", "n", {"type": "first curated context"}, "enter",
    ":", {"type": "context-item set text=\"revised curated context\""}, "enter",
    "N", {"type": "Ask for the spec link"}, "esc", "q",
    "n", {"type": "second curated context"}, "enter",
    "/", {"type": "second"}, "enter", "*",
    "/", "ctrl+a", "ctrl+k", {"type": "revised"}, "enter",
    ":", {"type": "setting set context.notes false"}, "enter",
    ":", {"type": "setting set context.notes true"}, "enter"
  ],
  "expect": [
    {"after": 2, "focus": "args-form/text", "modal": "args-form"},
    {"after": 4, "page": "context", "modal": "", "contains": ["first curated context"], "lacks": ["Notes (", "Ask for the spec link", "Error:"]},
    {"after": 7, "page": "context", "contains": ["revised curated context"], "lacks": ["first curated context", "Error:"]},
    {"after": 8, "modal": "quick-note", "mode": "insert", "contains": ["about context-item:"]},
    {"after": 11, "page": "context", "modal": "", "mode": "normal", "contains": ["Notes (", "Ask for the spec link"]},
    {"after": 17, "contains": ["second curated context"], "lacks": ["Notes (", "Ask for the spec link", "revised curated context"]},
    {"after": 18, "contains": ["second curated context", "★"]},
    {"after": 23, "contains": ["revised curated context", "Notes (", "Ask for the spec link"], "lacks": ["second curated context"]},
    {"after": 26, "contains": ["revised curated context"], "lacks": ["Notes (", "Ask for the spec link"]},
    {"page": "context", "modal": "", "contains": ["revised curated context", "Notes (", "Ask for the spec link"], "lacks": ["second curated context", "Error:"]}
  ]
}
