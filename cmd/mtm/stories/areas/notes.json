{
  "name": "mtm: write notes about panes, live terminals, tasks and projects, then revise and restore a scratch note",
  "area": "notes",
  "fixture": "area-notes",
  "width": 140,
  "height": 40,
  "config": {
    "bindings.json": [
      {"noun": "note", "mode": "normal", "keys": "ctrl+r", "request": {"noun": "note", "verb": "set", "args": {"props": {"archived": false}}}}
    ]
  },
  "script": [
    "]", "]", "]", "]", "]", "N", {"type": "the build is flaky"}, "esc", "q",
    "]", "]", "enter", "ctrl+a", "N", {"type": "keep this live observation"}, "esc", "q",
    "ctrl+a", "d", "ctrl+j", "}",
    "N", {"type": "checkout walkthrough note"}, "esc", "q", "{",
    "N", {"type": "release checklist walkthrough"}, "esc", "q",
    ":", {"type": "setting set notes.quick-about task"}, "enter",
    ":", {"type": "page open panes"}, "enter", "N", "esc", "q",
    ":", {"type": "page open notes"}, "enter",
    ":", {"type": "note new \"retained archive note\" --scratch"}, "enter",
    ":", {"type": "note edit \"retained archive note revised\""}, "enter", "q",
    ":", {"type": "note archive"}, "enter",
    ":", {"type": "collection filter-saved archived"}, "enter",
    "ctrl+r",
    ":", {"type": "collection filter-saved all"}, "enter"
  ],
  "expect": [
    {"after": 5, "page": "panes", "contains": ["[Notes]", "no notes about this pane yet"]},
    {"after": 6, "modal": "quick-note", "mode": "insert", "contains": ["about pane:"]},
    {"after": 8, "modal": "quick-note", "mode": "normal"},
    {"after": 9, "modal": "", "page": "panes", "mode": "normal", "contains": ["[Notes]", "the build is flaky"], "lacks": ["no notes about this pane yet"]},
    {"after": 12, "mode": "terminal", "focus": "panes/terminal"},
    {"after": 14, "modal": "quick-note", "mode": "insert"},
    {"after": 16, "modal": "quick-note", "mode": "normal"},
    {"after": 17, "modal": "", "page": "panes", "mode": "terminal", "focus": "panes/terminal"},
    {"after": 20, "page": "work", "contains": ["▾ Notes (2)", "Checkout release", "Check the shipping estimate"], "lacks": ["▾ Tasks", "Panes ("]},
    {"after": 21, "page": "work", "contains": ["Check the shipping estimate on mob"], "lacks": ["Notes (task)"]},
    {"after": 22, "modal": "quick-note", "mode": "insert", "contains": ["Checkout page"]},
    {"after": 25, "page": "work", "modal": "", "focus": "t1", "contains": ["checkout walkthrough note", "Check the shipping estimate"], "lacks": ["Notes (task)"]},
    {"after": 26, "contains": ["Checkout release", "checkout walkthrough note", "Check the shipping estimate"]},
    {"after": 30, "page": "work", "modal": "", "contains": ["release checklist walkthrough", "checkout walkthrough note", "Checkout release"]},
    {"after": 37, "modal": "quick-note", "mode": "insert", "lacks": ["about pane:"]},
    {"after": 39, "page": "panes", "modal": "", "mode": "normal"},
    {"after": 45, "page": "notes", "contains": ["retained archive note"], "lacks": ["Command palette", "Error:"]},
    {"after": 48, "page": "notes", "contains": ["retained archive note revised"], "lacks": ["Error:"]},
    {"after": 49, "page": "notes", "modal": "", "contains": ["retained archive note revised"], "lacks": ["Error:"]},
    {"after": 52, "lacks": ["retained archive note revised", "Command palette", "Error:"]},
    {"after": 55, "contains": ["[archived]", "retained archive note revised"], "lacks": ["Command palette", "Error:"]},
    {"after": 56, "lacks": ["retained archive note revised", "Error:"]},
    {"page": "notes", "modal": "", "contains": ["retained archive note revised", "Checkout release", "checkout walkthrough note", "release checklist walkthrough"], "lacks": ["Error:"]}
  ]
}
