{
  "name": "mtm: write notes about panes, live terminals, tasks and projects, then revise and restore a scratch note",
  "area": "notes",
  "fixture": "area-notes",
  "width": 140,
  "height": 40,
  "script": [
    "[", "N", {"type": "the build is flaky"}, "esc", "q",
    "]", "]", "enter", "ctrl+a", "N", {"type": "keep this live observation"}, "esc", "q",
    "ctrl+a", "d", "ctrl+j", "}",
    "N", {"type": "checkout walkthrough note"}, "esc", "q", "{",
    "N", {"type": "release checklist walkthrough"}, "esc", "q",
    ":", {"type": "setting set notes.quick-about task"}, "enter",
    ":", {"type": "page open panes"}, "enter", "N", "esc", "q",
    ":", {"type": "page open notes"}, "enter",
    ":", {"type": "note new \"retained archive note\" --scratch"}, "enter",
    ":", {"type": "note edit \"retained archive note revised\""}, "enter",
    ":", {"type": "note archive"}, "enter",
    ":", {"type": "collection filter-saved archived"}, "enter",
    ":", {"type": "note set @archive=false"}, "enter",
    ":", {"type": "collection filter-saved all"}, "enter"
  ],
  "expect": [
    {"after": 1, "page": "panes", "contains": ["[Notes]", "no notes about this pane yet"]},
    {"after": 2, "modal": "quick-note", "mode": "insert", "contains": ["about pane:"]},
    {"after": 4, "modal": "quick-note", "mode": "normal"},
    {"after": 5, "modal": "", "page": "panes", "mode": "normal", "contains": ["[Notes]", "the build is flaky"], "lacks": ["no notes about this pane yet"]},
    {"after": 8, "mode": "terminal", "focus": "panes/terminal"},
    {"after": 10, "modal": "quick-note", "mode": "insert"},
    {"after": 12, "modal": "quick-note", "mode": "normal"},
    {"after": 13, "modal": "", "page": "panes", "mode": "terminal", "focus": "panes/terminal"},
    {"after": 16, "page": "work", "contains": ["▾ Notes (2)", "Checkout release", "Check the shipping estimate"], "lacks": ["▾ Tasks", "Panes ("]},
    {"after": 17, "page": "work", "contains": ["Check the shipping estimate on mob"], "lacks": ["Notes (task)"]},
    {"after": 18, "modal": "quick-note", "mode": "insert", "contains": ["Checkout page"]},
    {"after": 21, "page": "work", "modal": "", "focus": "t1", "contains": ["checkout walkthrough note", "Check the shipping estimate"], "lacks": ["Notes (task)"]},
    {"after": 22, "contains": ["Checkout release", "checkout walkthrough note", "Check the shipping estimate"]},
    {"after": 26, "page": "work", "modal": "", "contains": ["release checklist walkthrough", "checkout walkthrough note", "Checkout release"]},
    {"after": 33, "modal": "quick-note", "mode": "insert", "lacks": ["about pane:"]},
    {"after": 35, "page": "panes", "modal": "", "mode": "normal"},
    {"after": 41, "page": "notes", "contains": ["retained archive note"], "lacks": ["Command palette", "Error:"]},
    {"after": 44, "page": "notes", "contains": ["retained archive note revised"], "lacks": ["Error:"]},
    {"after": 47, "lacks": ["retained archive note revised", "Command palette", "Error:"]},
    {"after": 50, "contains": ["[archived]", "retained archive note revised"], "lacks": ["Command palette", "Error:"]},
    {"after": 53, "lacks": ["retained archive note revised", "Error:"]},
    {"page": "notes", "modal": "", "contains": ["retained archive note revised", "Checkout release", "checkout walkthrough note", "release checklist walkthrough"], "lacks": ["Error:"]}
  ]
}
