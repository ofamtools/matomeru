{
  "name": "mtm: relation index shows a record form, edits text, archives and restores without adding a tab",
  "area": "relations",
  "fixture": "scaffold",
  "width": 160,
  "height": 52,
  "config": {
    "settings.json": {"collection.filter-linger": "0"},
    "bindings.json": [
      {"noun":"app","mode":"normal","keys":"ctrl+x","request":{"noun":"ochazuke.noun","verb":"show","args":{"noun":"relation"}}},
      {"noun":"app","mode":"normal","keys":"ctrl+t","request":{"noun":"ochazuke.focus","verb":"to","args":{"id":"nouns/relation/form/text"}}},
      {"noun":"relation","mode":"normal","keys":"ctrl+d","request":{"noun":"relation","verb":"archive"}},
      {"noun":"relation","mode":"normal","keys":"ctrl+u","request":{"noun":"relation","verb":"set","args":{"props":{"archived":false}}}}
    ]
  },
  "script": ["ctrl+x", "ctrl+t", "i", "ctrl+a", "ctrl+k", {"type":"edited relation"}, "esc", "shift+tab", "ctrl+d", "z", "a", "ctrl+u", "ctrl+j"],
  "expect": [
    {"after":1,"page":"nouns/relation","contains":["summary","kind","from","to","text","archived","project:acme-web","scaffold relation"]},
    {"after":7,"contains":["edited relation"]},
    {"after":9,"lacks":["edited relation"]},
    {"after":11,"contains":["edited relation"]},
    {"after":12,"contains":["edited relation"]},
    {"lacks":["nouns/relation  "]}
  ]
