{
  "name": "mtm: curated Items groups before its bounded window and folds survive j/k page edges",
  "area": "inbox",
  "fixture": "seeded",
  "width": 120,
  "height": 30,
  "config": {
    "settings.json": {"collection.window": 1, "inbox.group": "source"},
    "bindings.json": [
      {"noun": "app", "mode": "normal", "keys": "ctrl+g", "request": {"noun": "ochazuke.page", "verb": "open", "args": {"id": "inbox"}}},
      {"noun": "app", "mode": "normal", "keys": "ctrl+x", "request": {"noun": "ochazuke.collection", "verb": "group-fold", "args": {"id": "inbox/list"}}}
    ]
  },
  "seed": {"items": [{"source": "gh", "key": "another", "title": "Another request"}]},
  "script": ["ctrl+g", "ctrl+x", "j", "j", "k", "ctrl+x"],
  "expect": [
    {"after": 1, "page": "inbox", "contains": ["page 1/3", "gh"], "lacks": ["standup notes"]},
    {"after": 2, "contains": ["gh"], "lacks": ["Checkout: shipping", "Another request", "standup notes"]},
    {"after": 3, "contains": ["page 2/3", "gh"], "lacks": ["Checkout: shipping", "Another request", "standup notes"]},
    {"after": 4, "contains": ["page 3/3", "standup notes"]},
    {"after": 5, "contains": ["page 2/3", "gh"], "lacks": ["Checkout: shipping", "Another request", "standup notes"]},
    {"contains": ["page 2/3", "●"], "lacks": ["standup notes"]}
  ]
}
